<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: Nifty 50 and up to 5 watchlist stocks with price and today's change. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Watchlist"
            android:textColor="@color/w_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true" />
        <TextView
            android:id="@+id/w_nifty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_sub"
            android:textSize="12sp"
            android:singleLine="true" />
        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh prices" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/w_sub"
        android:textSize="11sp" />

    <LinearLayout android:id="@+id/w_row1" style="@style/WRow">
        <TextView android:id="@+id/w_name1" style="@style/WName" />
        <TextView android:id="@+id/w_price1" style="@style/WPrice" />
        <TextView android:id="@+id/w_chg1" style="@style/WChg" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row2" style="@style/WRow">
        <TextView android:id="@+id/w_name2" style="@style/WName" />
        <TextView android:id="@+id/w_price2" style="@style/WPrice" />
        <TextView android:id="@+id/w_chg2" style="@style/WChg" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row3" style="@style/WRow">
        <TextView android:id="@+id/w_name3" style="@style/WName" />
        <TextView android:id="@+id/w_price3" style="@style/WPrice" />
        <TextView android:id="@+id/w_chg3" style="@style/WChg" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row4" style="@style/WRow">
        <TextView android:id="@+id/w_name4" style="@style/WName" />
        <TextView android:id="@+id/w_price4" style="@style/WPrice" />
        <TextView android:id="@+id/w_chg4" style="@style/WChg" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row5" style="@style/WRow">
        <TextView android:id="@+id/w_name5" style="@style/WName" />
        <TextView android:id="@+id/w_price5" style="@style/WPrice" />
        <TextView android:id="@+id/w_chg5" style="@style/WChg" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Open Stock Lens and add stocks to your Watchlist"
        android:textColor="@color/w_sub"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
